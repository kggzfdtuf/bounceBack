[sub_resource type="GDScript" id="GDScript_w48qg"]
script/source = "extends CharacterBody2D

var history : Array = []
@export var tilemap : TileMapLayer
@export var buttonmap : TileMapLayer
const COOLDOWN = 1.0
var cooldown = 0.0
const SPEED = 90.0
const MAX_JUMP_TIME = 0.75
var jump_time = 0.0
var jumping = false
var start_jumping = false
const CAJOTIE_TIME = 0.05
var cajotie_time = 0.0
const JUMP_VELOCITY = -600.0
const MAX_JUMP_VELOCITY = -400
var can_doors = false
var door_cooldown = 0

var old_tile = -1

func _physics_process(delta: float) -> void:
	if buttonmap:
		buttonmap.collision_enabled = not can_doors
	door_cooldown -= delta
	if door_cooldown < 0:
		can_doors = false
	var pos = tilemap.to_local(global_position)
	var coords = tilemap.local_to_map(pos)
	# 0 == layer index
	var data = tilemap.get_cell_source_id(coords)
	if data != old_tile:
		print(data)
		old_tile = data
	if data == 3:
		velocity.y = -1000.0
	if data == 4:
		velocity.y = 1000.0
	cooldown -= delta
	if Input.is_action_just_pressed(\"ui_up\") or Input.is_action_just_pressed(\"ui_accept\"):
		start_jumping = true
		$AnimatedSprite2D.play(\"springen\")
	elif not Input.is_action_pressed(\"ui_up\") and not Input.is_action_pressed(\"ui_accept\"):
		start_jumping = false
	if is_on_floor():
		cajotie_time = CAJOTIE_TIME
	else:
		cajotie_time -= delta

	if cajotie_time > 0:
		jump_time = MAX_JUMP_TIME
		jumping = false
		if start_jumping and (Input.is_action_pressed(\"ui_up\") or Input.is_action_pressed(\"ui_accept\")):
			cajotie_time = 0
			jumping = true
			velocity.y = MAX_JUMP_VELOCITY/2
	else:
		jump_time -= delta
		velocity += get_gravity() * delta
		
	if (Input.is_action_pressed(\"ui_up\") or Input.is_action_pressed(\"ui_accept\")) and jumping and jump_time > 0:
		$AnimatedSprite2D.play(\"in_air\")
		start_jumping = false
		velocity.y += JUMP_VELOCITY * delta
		if velocity.y < MAX_JUMP_VELOCITY:
			velocity.y = MAX_JUMP_VELOCITY
	else:
		$AnimatedSprite2D.play(\"in_air\")
		jumping = false

	var direction := Input.get_axis(\"ui_left\", \"ui_right\")
	if data == 5:
		velocity.x = -1000.0
	elif direction:
		if is_on_floor():
			$AnimatedSprite2D.play(\"laufen\")
		velocity.x = direction * SPEED
		if direction < 0:
			$AnimatedSprite2D.scale.x = -1
		elif direction > 0:
			$AnimatedSprite2D.scale.x = 1
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)
		if is_on_floor():
			$AnimatedSprite2D.play(\"idle\")

	var pos2 = buttonmap.to_local(global_position)
	var coords2 = buttonmap.local_to_map(pos)
	# 0 == layer index
	var data2 = buttonmap.get_cell_source_id(coords)
	
	if data2 == 1:
		can_doors = true
		door_cooldown = 5.0

	var current_time = Time.get_ticks_msec() / 1000
	history.append({\"time\" : current_time, \"pos\" : global_position})
	for i in range(len(history)):
		if i < len(history):
			if current_time - history[i][\"time\"] > 1.5:
				history.pop_at(i)
	if Input.is_action_just_pressed(\"ui_cancel\") and cooldown <= 0:
		position = history[0][\"pos\"]
		cooldown = COOLDOWN

	move_and_slide()
"

