[sub_resource type="GDScript" id="GDScript_w48qg"]
script/source = "extends CharacterBody2D

var history : Array = []

const COOLDOWN = 1.0
var cooldown = 0.0
const SPEED = 90.0
const MAX_JUMP_TIME = 0.75
var jump_time = 0.0
var jumping = false
var start_jumping = false
const CAJOTIE_TIME = 0.05
var cajotie_time = 0.0
const JUMP_VELOCITY = -400.0
const MAX_JUMP_VELOCITY = -400

func _physics_process(delta: float) -> void:
	if Input.is_action_just_pressed(\"ui_up\") or Input.is_action_just_pressed(\"ui_accept\"):
		start_jumping = true
	elif not Input.is_action_pressed(\"ui_up\") and not Input.is_action_pressed(\"ui_accept\"):
		start_jumping = false
	if is_on_floor():
		cajotie_time = CAJOTIE_TIME
	else:
		cajotie_time -= delta

	if cajotie_time > 0:
		jump_time = MAX_JUMP_TIME
		jumping = false
		if start_jumping and (Input.is_action_pressed(\"ui_up\") or Input.is_action_pressed(\"ui_accept\")):
			cajotie_time = 0
			jumping = true
			velocity.y = MAX_JUMP_VELOCITY/2
	else:
		jump_time -= delta
		velocity += get_gravity() * delta
		
	if (Input.is_action_pressed(\"ui_up\") or Input.is_action_pressed(\"ui_accept\")) and jumping and jump_time > 0:
		start_jumping = false
		velocity.y += JUMP_VELOCITY * delta
		if velocity.y < MAX_JUMP_VELOCITY:
			velocity.y = MAX_JUMP_VELOCITY
	else:
		jumping = false

	var direction := Input.get_axis(\"ui_left\", \"ui_right\")
	if direction:
		velocity.x = direction * SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)


	var current_time = Time.get_ticks_msec() / 1000
	history.append({\"time\" : current_time, \"pos\" : global_position})
	for i in range(len(history)):
		if i < len(history):
			if current_time - history[i][\"time\"] > 1.5:
				history.pop_at(i)
	if Input.is_action_just_pressed(\"ui_cancel\"):
		position = history[0][\"pos\"]

	move_and_slide()
"

